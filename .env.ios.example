# Required for local automatic signing. Get this 10-character ID from
# Apple Developer > Membership details, then copy this file to .env.ios.
APPLE_DEVELOPMENT_TEAM=YOUR_10_CHARACTER_TEAM_ID

# Required only when automatic signing runs on CI. Do not commit the .p8 key.
# APPLE_API_ISSUER=YOUR_APP_STORE_CONNECT_ISSUER_ID
# APPLE_API_KEY=YOUR_APP_STORE_CONNECT_KEY_ID
# APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Alternative for manual/CI signing. Values are Base64; do not set these when
# using Xcode automatic signing unless manual signing is intentional.
# IOS_CERTIFICATE=BASE64_ENCODED_APPLE_DISTRIBUTION_P12
# IOS_CERTIFICATE_PASSWORD=YOUR_P12_PASSWORD
# IOS_MOBILE_PROVISION=BASE64_ENCODED_APP_STORE_CONNECT_PROFILE
