{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Application Factory",
  "version": "0.1.0",
  "identifier": "com.aiapplicationfactory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace frontend -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --workspace frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Application Factory",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost media: data: blob:; img-src 'self' asset: http://asset.localhost https://asset.localhost media: data: blob: https: http:; media-src 'self' asset: http://asset.localhost https://asset.localhost media: data: blob: https: http:; connect-src 'self' https: http: tauri:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/skills/"],
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI video creation workspace",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
